rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Boarding records created by authorized systems, ESP32, or clients
    match /boarding_records/{document} {
      allow read, write: if true;
    }
    
    // Parent device registrations for FCM tokens
    match /parent_devices/{document} {
      allow read, write: if true;
    }
    
    // Idempotency tracking to prevent duplicate notifications
    match /fcm_sent_logs/{document} {
      allow read, write: if true;
    }
    
    // Student, bus, device metadata
    match /students/{document} {
      allow read, write: if true;
    }
    match /devices/{document} {
      allow read, write: if true;
    }
    match /transport_chat/{document} {
      allow read, write: if true;
    }
  }
}
